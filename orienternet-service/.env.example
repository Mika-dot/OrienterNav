# Authentication. Use the same value in Android settings.
ORIENTERNET_API_KEY=replace-with-a-long-random-string

# Model / localization settings.
ORIENTERNET_ROTATIONS=128
ORIENTERNET_SEARCH_RADIUS_M=128
MAX_IMAGE_BYTES=12582912

# Network settings used by the Windows launch scripts.
ORIENTERNET_HOST=0.0.0.0
ORIENTERNET_PORT=1000

# Cache directory. Relative paths are resolved from orienternet-service.
ORIENTERNET_CACHE=cache

# Recommended checkpoint location:
#   OrienterNav\orienternet_mgl.ckpt
# The service also checks orienternet-service\orienternet_mgl.ckpt and the
# original maploc experiments directory.
# ORIENTERNET_CHECKPOINT=..\orienternet_mgl.ckpt

# API-only test mode; no neural network is executed.
ORIENTERNET_MOCK=0
